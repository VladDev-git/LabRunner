# Copy to .env and change the secrets:  cp .env.example .env
# .env is ignored by git (Twelve-Factor App, factor III).

API_PORT=8080

DB_NAME=labrunner
DB_USER=labrunner
DB_PASSWORD=change-me-db

REDIS_PASSWORD=change-me-redis

# S3-compatible storage (RustFS locally). The secret key must be at least 8 characters.
S3_ACCESS_KEY=labrunner
S3_SECRET_KEY=change-me-storage
S3_BUCKET=labrunner-reports
