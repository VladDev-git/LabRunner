# Single entry point on port 80 (the only application port open in UFW besides 443).
:80 {
	encode gzip

	# Metrics are scraped by Prometheus inside monitoring-net; never expose them outside.
	# Must be a `handle` block: a bare `respond` runs after `handle` in Caddy's directive
	# order, so the catch-all proxy below would answer /metrics first (found in lab 5).
	handle /metrics* {
		respond "Not Found" 404
	}

	handle /grafana* {
		reverse_proxy grafana:3000
	}

	handle {
		reverse_proxy api:8080
	}

	log {
		output stdout
		format console
	}
}
